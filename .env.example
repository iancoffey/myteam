# Postgres connection string (Neon via the Vercel marketplace). Leave unset locally
# to use the embedded PGlite database stored in .data/.
DATABASE_URL=

# Long random string used to sign session cookies: `openssl rand -base64 32`
AUTH_SECRET=

# Static coach logins, comma-separated email:password pairs.
# Locally, if unset, coach@example.com / soccer works.
AUTH_USERS=coach@example.com:change-me
