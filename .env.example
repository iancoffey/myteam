# Postgres connection string (Neon). Leave unset locally to use the embedded PGlite database in .data/.
DATABASE_URL=

# Coach logins, comma-separated email:password pairs. Locally, if unset, coach@example.com / soccer works.
AUTH_USERS=coach@example.com:change-me

# Optional: signs sign-in cookies. Without it, a key derived from DATABASE_URL is used.
AUTH_SECRET=
